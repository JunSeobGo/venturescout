# ── AWS Bedrock ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ── PostgreSQL (+pgvector) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=venturescout
POSTGRES_USER=vs
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://vs:changeme@localhost:5432/venturescout

# ── 임베딩 (데이터 소스 확정 후) ──
# 영어: AI-Growth-Lab/PatentSBERTa (768d)
# 한국어: KorPatBERT large (768d)
# 폴백: intfloat/multilingual-e5-large (1024d → init.sql 차원 변경 필요)
EMBEDDING_MODEL=AI-Growth-Lab/PatentSBERTa
EMBEDDING_DIM=768

# ── Track D (api/ui) ──
API_URL=http://localhost:8000     # ui.py가 구독할 FastAPI (compose: http://api:8000)
DEMO_DELAY=0.4                     # 단계 가시성용 인위 지연(초). 실 LLM 붙으면 0