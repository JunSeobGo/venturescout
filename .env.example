# ── AWS Bedrock ──
# 리전·모델 ID는 계정마다 다르다. Bedrock 콘솔 > Model access에서 켠 리전과 맞춰라.
# 추론 프로파일 접두사(us. / global. / apac.)도 계정에 따라 다르므로
# boto3 bedrock.list_inference_profiles()로 확인 후 넣는다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENT_LLM_PROVIDER=bedrock

# ── 실행 상한 (guardrail) ──
# 잡 1건이 쓸 수 있는 상한. 넘으면 다음 LLM 호출을 막고 job을 failed로 종료한다.
# 분석 1건 실측이 약 $0.40(7~8콜)이라 기본값은 폭주만 잡고 정상 실행은 막지 않는 선.
# 0 = 제한 없음.
MAX_COST_USD_PER_JOB=1.5
MAX_LLM_CALLS_PER_JOB=40
GRAPH_RECURSION_LIMIT=15
RETRIEVAL=live
# 계정/region에서 허용된 model ID 또는 inference profile ID로 교체 가능
BEDROCK_SONNET_MODEL_ID=global.anthropic.claude-sonnet-4-6

# ── PostgreSQL (+pgvector, AWS RDS) ──
# 접속 정보는 팀 채널에서 받아 각자 .env에 채운다(이 파일에는 두지 않는다).
POSTGRES_HOST=<rds-endpoint>
POSTGRES_PORT=5432
POSTGRES_DB=venturescout
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://<db-user>:<password>@<rds-endpoint>:5432/venturescout?sslmode=verify-full&sslrootcert=db/certs/rds-global-bundle.pem
DB_CONNECT_TIMEOUT=10

# ── 임베딩 (데이터 소스 확정 후) ──
# 영어: AI-Growth-Lab/PatentSBERTa (768d)
# 한국어: KorPatBERT large (768d)
# 폴백: intfloat/multilingual-e5-large (1024d → init.sql 차원 변경 필요)
# DATA_SOURCE="USPTO" -> PatentSBERTa / "KIPRIS" -> KorPatBERT (config.py __post_init__)
DATA_SOURCE=USPTO
EMBEDDING_MODEL=AI-Growth-Lab/PatentSBERTa
EMBEDDING_DIM=768

# ── Track D (api/ui) ──
API_URL=http://localhost:8000     # ui.py가 구독할 FastAPI (compose: http://api:8000)
DEMO_DELAY=0.4                     # 단계 가시성용 인위 지연(초). 실 LLM 붙으면 0
