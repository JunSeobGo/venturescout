// VentureScout Tier 0 — 9 tables (기본 6 + 시그니처 3)
// dbdiagram.io 붙여넣기용. 원칙: 계약 strict / output_json / pgvector 단일 스토어

Table ideas {
  idea_id uuid [pk]
  raw_input text
  title varchar
  idea_type varchar
  target_customer text
  problem_statement text
  solution_summary text
  business_model_hint text
  technical_elements json
  patent_keywords json
  user_confirmed boolean
  created_at timestamp
}
Table analysis_jobs {
  job_id uuid [pk]
  idea_id uuid
  status varchar
  current_stage varchar
  progress_pct int
  decision varchar
  decision_summary text
  started_at timestamp
  finished_at timestamp
}
Table hypotheses {
  hypothesis_id uuid [pk]
  job_id uuid
  idea_id uuid
  code varchar
  axis varchar
  statement text
  confidence varchar
  next_validation text
}
Table documents {
  document_id uuid [pk]
  source_type varchar
  ext_id varchar
  title varchar
  canonical_url varchar
  clean_text text
  embedding vector
  meta json
  reliability_score decimal
  freshness_score decimal
  is_user_provided boolean
}
Table evidence_items {
  evidence_id uuid [pk]
  job_id uuid
  hypothesis_id uuid
  document_id uuid
  source_type varchar
  evidence_text text
  stance varchar
  relevance_score decimal
  reliability_score decimal
}
Table agent_runs {
  agent_run_id uuid [pk]
  job_id uuid
  hypothesis_id uuid
  agent_name varchar
  model_name varchar
  depth varchar
  confidence varchar
  grounded_on json
  output_json json
  target_run_id uuid
  groundedness_score decimal
  overclaim_flag boolean
  status varchar
}
Table patent_claims {
  claim_id uuid [pk]
  document_id uuid
  claim_no int
  claim_text text
  is_independent boolean
  parent_claim_no int
}
Table claim_limitations {
  limitation_id uuid [pk]
  claim_id uuid
  limitation_order int
  normalized_text text
  embedding vector
}
Table ip_overlap_candidates {
  candidate_id uuid [pk]
  job_id uuid
  hypothesis_id uuid
  limitation_id uuid
  evidence_id uuid
  plan_technical_element text
  lexical_score decimal
  similarity_score decimal
  hybrid_score decimal
  rank int
}

Ref: ideas.idea_id < analysis_jobs.idea_id
Ref: ideas.idea_id < hypotheses.idea_id
Ref: analysis_jobs.job_id < hypotheses.job_id
Ref: analysis_jobs.job_id < evidence_items.job_id
Ref: hypotheses.hypothesis_id < evidence_items.hypothesis_id
Ref: documents.document_id < evidence_items.document_id
Ref: analysis_jobs.job_id < agent_runs.job_id
Ref: hypotheses.hypothesis_id < agent_runs.hypothesis_id
Ref: documents.document_id < patent_claims.document_id
Ref: patent_claims.claim_id < claim_limitations.claim_id
Ref: analysis_jobs.job_id < ip_overlap_candidates.job_id
Ref: hypotheses.hypothesis_id < ip_overlap_candidates.hypothesis_id
Ref: claim_limitations.limitation_id < ip_overlap_candidates.limitation_id
Ref: evidence_items.evidence_id < ip_overlap_candidates.evidence_id
